#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
qmllint=${QMLLINT:-/usr/lib/qt6/bin/qmllint}
[[ -x $qmllint ]] || { echo "qmllint не найден: $qmllint" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/qs"
ln -s /usr/share/omarchy/shell/Ui "$tmp/qs/Ui"
ln -s /usr/share/omarchy/shell/Commons "$tmp/qs/Commons"
"$qmllint" -I "$tmp" -I /usr/lib/qt6/qml \
  "$root/BarWidget.qml" "$root/Widget.qml" "$root/RemoteHostsIcon.qml" "$root/state/DraftState.qml"
